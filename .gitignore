# Extraction output (the tool writes one timestamped JSON per run here)
extractions/
swydo_out/
out/
*_out/
# stray extraction files if run outside the default dir
????-??-??-??-??-??-*.json

# Local scratch / secrets
*.local
.env
scratch/

# OS / editor
Thumbs.db
.DS_Store

# client data archives - never commit
skill/archive/

# Linked worktrees live INSIDE the repo, so they must be excluded or a worktree's whole tree shows
# up as untracked. This was previously only in .git/info/exclude, which is local and never travels
# - a fresh clone would not have it. Tracked here so the exclusion survives.
.claude/worktrees/

# settings-merge.py's backup, written whenever a hook block is merged.
.claude/settings.json.bak

